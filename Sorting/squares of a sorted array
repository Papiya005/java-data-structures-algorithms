import java.util.Arrays;
class Solution {
    public int[] sortedSquares(int[] nums) {
       
       int n=nums.length;
    //     int ans[]=new int[n];
    //    for(int i=0;i<n;i++){
    //     ans[i]=nums[i]*nums[i];
    //    }
    //   Arrays.sort(ans);
    //   return ans;
    int left=0;
    int right=n-1;
    int ans[]=new int[n];
    int index=n-1;
    while(left<=right){
       if(Math.abs(nums[left])>Math.abs(nums[right])){
          ans[index--]=nums[left]*nums[left];
          left++;
          

       } 
       else{
        ans[index--]=nums[right]*nums[right];
          right--;
       }
    }

    return ans;

    }
}
